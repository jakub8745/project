{
  "schemaVersion": "2.0.0",
  "id": "prompt_procedural_room",
  "kind": "exhibit",
  "metadata": {
    "title": "Collision Salon",
    "description": "A fully generated procedural room where robots and translucent blobs move, collide, and turn physical contact into short art-focused chat exchanges. No scene GLB is used for the room; geometry, actors, physics, wall prints, and chat behavior are declared by config.",
    "language": "en",
    "tags": [
      "procedural room",
      "chat",
      "physics",
      "generated installation"
    ]
  },
