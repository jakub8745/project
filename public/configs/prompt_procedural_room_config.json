      "kind": "generic",
      "metadata": {
        "category": "moving_actor",
        "collisionRadius": 0.95,
        "interactionDescription": "robot is a generated moving GLB actor. It wanders inside room bounds, avoids obstacles, participates in physics collisions, and can trigger collision chat."
      }
    },
    "robot_2": {
