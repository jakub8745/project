      "kind": "sculpture",
      "metadata": {
        "category": "generated_blob",
        "collisionRadius": 0.65,
        "interactionDescription": "blob_alpha is generated by the app as a deforming translucent blob. It moves through the procedural room, reflects the environment, collides with the visitor/other actors, and can trigger art-focused chat."
      }
    },
    "blob_beta": {
      "kind": "sculpture",
      "metadata": {
        "category": "generated_blob",
        "collisionRadius": 0.92,
        "interactionDescription": "blob_beta is generated by the app as a deforming translucent blob. It moves through the procedural room, reflects the environment, collides with the visitor/other actors, and can trigger art-focused chat."
