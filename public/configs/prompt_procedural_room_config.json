  "interactions": [
    {
      "id": "visitor_robot_collision_chat",
      "targetNode": "visitor",
      "trigger": "collision",
      "action": {
        "type": "emit_event",
        "event": "chat.collision",
        "payload": {
          "actors": [
            "visitor",
            "robot",
            "robot_2"
          ]
        }
      },
      "ui": {
        "title": "Visitor collision chat",
        "description": "When the visitor physically bumps into a configured robot actor, the physics system emits a collision event. The app routes that event into Blob Salon chat with cooldown protection so contact becomes a short art-focused exchange."
      },
      "metadata": {
        "interactionDescription": "When the visitor physically bumps into a configured robot actor, the physics system emits a collision event. The app routes that event into Blob Salon chat with cooldown protection so contact becomes a short art-focused exchange."
      }
    },
    {
      "id": "blob_collision_chat",
      "targetNode": "blob_alpha",
      "trigger": "collision",
      "action": {
        "type": "emit_event",
        "event": "chat.collision",
        "payload": {
          "actors": [
            "blob_alpha",
            "blob_beta",
            "visitor"
          ]
        }
      },
      "ui": {
        "title": "Blob collision chat",
        "description": "Generated blobs are pushable physics actors. Collisions between blobs, robots, and the visitor are treated as encounter-based prompts rather than direct button interactions."
      },
      "metadata": {
        "interactionDescription": "Generated blobs are pushable physics actors. Collisions between blobs, robots, and the visitor are treated as encounter-based prompts rather than direct button interactions."
      }
    },
    {
      "id": "surface_prints",
      "targetNode": "visitor",
      "trigger": "custom",
      "action": {
        "type": "emit_event",
        "event": "surface.prints.poll"
      },
      "ui": {
        "title": "Conversation prints on walls",
        "description": "The procedural room polls recent chat prints and renders fragments onto wall surfaces. The visible text field is generated by runtime conversation, not baked into a model."
      },
      "metadata": {
        "interactionDescription": "The procedural room polls recent chat prints and renders fragments onto wall surfaces. The visible text field is generated by runtime conversation, not baked into a model."
      }
    }
  ],
