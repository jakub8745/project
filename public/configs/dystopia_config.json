      "exposureTarget": 0.68,
      "exposureMin": 0.5,
      "exposureMax": 1.65,
      "exposureSampleInterval": 30
    }
  },
  "nodes": {
    "dzbanDystopia": {
      "kind": "audio_anchor",
      "ref": "dzbanDystopia",
      "metadata": {
        "transformControls": {
          "mode": "rotate",
          "size": 0.3,
          "hover": true,
          "light": {
            "enabled": true,
            "color": 16777215,
            "intensity": 40,
            "yOffset": 3,
            "angle": 0.4487989505128276,
            "penumbra": 0.3,
            "decay": 2,
            "distance": 35,
            "castShadow": true,
            "shadowMapSize": 2048,
            "shadowBias": 0,
            "shadowNormalBias": 0.02,
            "shadowRadius": 2,
            "shadowCameraNear": 0.5,
            "shadowCameraFar": 40
          }
        },
        "category": "pitcher",
        "interactionDescription": "The dzbanDystopia node anchors spatial audio. Distance, rolloff, looping, volume, and optional transform behavior are declared in the audio module."
      },
      "media": "dzbanDystopia"
    },
    "Milkmaid": {
      "kind": "image_anchor",
      "media": "Milkmaid",
      "metadata": {
        "interactionDescription": "Click Milkmaid to open the image metadata panel."
      }
    }
  },
  "media": {
    "Milkmaid": {
      "kind": "image",
      "title": "Milkmaid",
      "description": "Jaroslaw Solecki's The Dystopia of an Imitation presents a creative way of exploring the 'matter' of art. The central issue taken up in the work is the sculpting process realised in stone, clay and in the form of digital 3D graphics[...] Quote from the exhibition booklet \"The Dystopia of an Imitation\"",
      "author": "Jaroslaw Solecki",
      "image": {
        "asset": "Milkmaid_image"
      }
    },
    "dzbanDystopia": {
      "kind": "audio",
      "sources": [
        {
          "asset": "dzbanDystopia_audio"
        }
      ]
    }
  },
  "interactions": [
    {
      "id": "dzbanDystopia_transform_controls_hover",
      "targetNode": "dzbanDystopia",
      "trigger": "hover",
      "action": {
        "type": "enable_transform_controls",
        "mode": "rotate",
        "size": 0.3
      },
      "ui": {
        "title": "Rotate dzbanDystopia",
        "description": "Hovering dzbanDystopia reveals a transform control gizmo. Dragging the gizmo rotates the configured object while the local spotlight settings remain controlled by the config."
      },
      "metadata": {
        "interactionDescription": "Hovering dzbanDystopia reveals a transform control gizmo. Dragging the gizmo rotates the configured object while the local spotlight settings remain controlled by the config."
      }
    },
    {
      "id": "Milkmaid_open_image",
      "targetNode": "Milkmaid",
      "trigger": "click",
      "action": {
        "type": "open_image",
        "media": "Milkmaid"
      },
      "ui": {
        "title": "Milkmaid",
        "description": "Clicking Milkmaid opens the image entry \"Milkmaid\" with title, description, author, and source asset from the config."
      },
      "metadata": {
        "interactionDescription": "Clicking Milkmaid opens the image entry \"Milkmaid\" with title, description, author, and source asset from the config."
      }
    },
    {
      "id": "dzbanDystopia_spatial_audio",
      "targetNode": "dzbanDystopia",
      "trigger": "proximity",
      "action": {
        "type": "play_audio",
        "moduleInstance": "dzbanDystopia_audio"
      },
      "ui": {
        "title": "dzbanDystopia",
        "description": "Approaching dzbanDystopia places the visitor inside the configured spatial audio field. The sound uses refDistance=3, rolloff=1, loop=true, and volume=0.5."
      },
      "metadata": {
        "interactionDescription": "Approaching dzbanDystopia places the visitor inside the configured spatial audio field. The sound uses refDistance=3, rolloff=1, loop=true, and volume=0.5."
      }
    }
  ],
