    "sculptureControls": {
      "instances": [
        {
          "id": "dzbanDystopia_transform_controls",
          "targetNode": "dzbanDystopia",
          "mode": "rotate",
          "size": 0.3,
          "hover": true,
          "light": {
            "enabled": true,
            "color": 16777215,
            "intensity": 40,
