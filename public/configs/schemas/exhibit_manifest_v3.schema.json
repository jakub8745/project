{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bluepointart.uk/schemas/exhibit_manifest_v3.schema.json",
  "title": "Future-Proof Exhibit Archive Manifest v3",
  "type": "object",
  "required": [
    "schemaVersion",
    "manifestType",
    "profile",
    "id",
    "metadata",
    "assets",
    "content",
    "sceneGraph",
    "interactions",
    "viewerBrief",
    "preservation"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^3\\."
    },
    "manifestType": {
      "const": "future-proof-exhibit-archive"
    },
    "profile": {
      "enum": [
        "portable-exhibit",
        "portable-exhibit-nft"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string"
    },
    "sourceManifest": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schemaVersion",
        "path"
      ],
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "required": [
        "title",
        "description"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "archiveDescription": {
          "type": "string"
        },
        "language": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object"
    },
    "rights": {
      "type": "object"
    },
    "nft": {
      "type": "object",
      "required": [
        "mintable"
      ],
      "properties": {
        "mintable": {
          "type": "boolean"
        },
        "canonicalManifestAsset": {
          "type": "string"
        },
        "canonicalSceneAsset": {
          "type": "string"
        },
        "canonicalPreviewAsset": {
          "type": "string"
        },
        "tokenMetadataTemplate": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "assets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "sourceUri",
          "ipfsUri",
          "mimeType",
          "preservation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "sourceUri": {
            "type": "string",
            "minLength": 1,
            "description": "Manifest-declared source URI. It may identify a local development file, Oracle object, or other archive source. The viewer never derives an object location from the exhibit ID or filename."
          },
          "ipfsUri": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^ipfs://"
              },
              {
                "type": "null"
              }
            ]
          },
          "arweaveUri": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "fallbackUris": {
            "type": "array",
            "description": "Additional manifest-declared source URIs. BPA production resolution prioritizes configured Oracle Object Storage, then the canonical IPFS CID through the shared gateway list, then other configured immutable/archive sources, then local development paths.",
            "items": {
              "type": "string"
            }
          },
          "mimeType": {
            "type": "string"
          },
          "byteSize": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "availableLocal": {
            "type": "boolean"
          },
          "preservation": {
            "type": "object"
          },
          "rights": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "content": {
      "type": "object",
      "properties": {
        "media": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/assetRef"
                }
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": true
          }
        },
        "sidebar": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "label"
                ],
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "sceneGraph": {
      "type": "object",
      "required": [
        "sourceScene",
        "nodes"
      ],
      "properties": {
        "coordinateSystem": {
          "type": "object"
        },
        "sourceScene": {
          "type": "object",
          "properties": {
            "model": {
              "type": "object",
              "properties": {
                "asset": {
                  "type": "string"
                },
                "position": {
                  "$ref": "#/$defs/vector3"
                },
                "rotation": {
                  "$ref": "#/$defs/vector3"
                },
                "scale": {
                  "type": "number"
                }
              },
              "required": [
                "asset"
              ],
              "additionalProperties": true
            },
            "renderer": {
              "type": "object",
              "properties": {},
              "additionalProperties": true
            },
            "background": {
              "type": "object",
              "properties": {},
              "additionalProperties": true
            },
            "spawn": {
              "type": "object",
              "properties": {},
              "additionalProperties": true
            },
            "camera": {
              "type": "object",
              "properties": {},
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "media": {
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": true
          }
        },
        "modules": {
          "type": "object",
          "properties": {
            "audio": {
              "type": "object",
              "properties": {
                "instances": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "autoplayOnXrSessionStart": {
                        "type": "boolean",
                        "description": "Whether the viewer should start this audio instance when an immersive XR session begins."
                      }
                    },
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "viewerProfiles": {
          "type": "object",
          "properties": {
            "r3fCurrent": {
              "type": "object",
              "properties": {
                "params": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true
                },
                "proceduralRoom": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true
                },
                "models": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": true
                  }
                },
                "proceduralObjects": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": true
                  }
                },
                "physics": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true
                },
                "chat": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "proceduralRecipe": {
          "type": "object",
          "properties": {
            "room": {
              "type": "object",
              "properties": {},
              "additionalProperties": true
            },
            "models": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {},
                "additionalProperties": true
              }
            },
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {},
                "additionalProperties": true
              }
            },
            "physics": {
              "type": "object",
              "properties": {},
              "additionalProperties": true
            },
            "services": {
              "type": "object",
              "properties": {},
              "additionalProperties": true
            }
          },
          "required": [
            "room"
          ],
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "behavior": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "viewerBrief": {
      "type": "object",
      "required": [
        "purpose",
        "requiredCapabilities",
        "reconstructionPrompt"
      ],
      "properties": {
        "purpose": {
          "type": "string"
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reconstructionPrompt": {
          "type": "string"
        },
        "visualTone": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "preservation": {
      "type": "object",
      "required": [
        "futureProofDefinition",
        "requiredBeforeMinting"
      ],
      "additionalProperties": true
    },
    "exports": {
      "type": "object"
    },
    "previews": {
      "type": "object",
      "properties": {
        "capture": {
          "type": "object",
          "properties": {
            "r3fCurrent": {
              "type": "object",
              "properties": {},
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "const": "portable-exhibit-nft"
          }
        }
      },
      "then": {
        "required": [
          "nft"
        ],
        "properties": {
          "nft": {
            "required": [
              "mintable",
              "canonicalManifestAsset",
              "canonicalSceneAsset",
              "canonicalPreviewAsset",
              "tokenMetadataTemplate"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "assetRef": {
      "type": "object",
      "properties": {
        "asset": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "asset"
      ],
      "additionalProperties": true
    }
  }
}
