            "asset": "dzbanDystopia_audio"
          }
        ]
      },
      "info_text": {
        "kind": "text",
        "text": "This exhibit is still in its experimental stage. Some things may change, break, or disappear as we keep testing new ideas. You're welcome to look around, try things out, and see how it evolves. Thanks for being part of the experiment!"
      }
